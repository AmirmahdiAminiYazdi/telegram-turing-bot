[Unit]
Description=Course sales Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
User=bot
WorkingDirectory=/opt/telegram-turing-bot
EnvironmentFile=/opt/telegram-turing-bot/.env
ExecStart=/opt/telegram-turing-bot/.venv/bin/python -m bot.main
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/telegram-turing-bot/data

[Install]
WantedBy=multi-user.target
