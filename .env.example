# توکن ربات از @BotFather
BOT_TOKEN=
# آیدی عددی ادمین‌ها با کاما. خالی = اولین ادمین با /claim تعیین می‌شود (کد در لاگ استارت است)
ADMIN_IDS=
DB_PATH=data/bot.sqlite3
# یوزرنیم پشتیبانی بدون @ (اختیاری)
SUPPORT_USERNAME=

# --- کارت‌به‌کارت ---
CARD_NUMBER=
CARD_HOLDER=

# --- زرین‌پال (بدون مرچنت و آدرس عمومی، پرداخت آنلاین خاموش است) ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# دامنه‌ای که به سرور اشاره می‌کند؛ با Docker و --profile https گواهی HTTPS خودکار می‌گیرد
DOMAIN=
PUBLIC_BASE_URL=

WEB_HOST=0.0.0.0
WEB_PORT=8080
# فاصله‌ی حداقلی بین دو رویداد یک کاربر (ثانیه)
THROTTLE_SECONDS=0.4
