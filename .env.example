# توکن ربات از @BotFather
BOT_TOKEN=
# آیدی عددی ادمین‌ها، جدا شده با کاما
ADMIN_IDS=
# مسیر دیتابیس SQLite
DB_PATH=data/bot.sqlite3
# یوزرنیم پشتیبانی بدون @
SUPPORT_USERNAME=

# --- کارت‌به‌کارت ---
CARD_NUMBER=
CARD_HOLDER=

# --- زرین‌پال (اگر خالی باشد، پرداخت آنلاین غیرفعال می‌شود) ---
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# آدرس عمومی HTTPS سرور شما برای بازگشت از درگاه، مثلا https://bot.example.com
PUBLIC_BASE_URL=
WEB_HOST=0.0.0.0
WEB_PORT=8080
